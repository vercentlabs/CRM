# Worker (apps/worker): outbox relay, queue consumers, reminders, maintenance.
# See docs/architecture/RUNTIME_PLATFORM.md. Never commit real values.
NODE_ENV=development
DATABASE_URL=postgresql://crm:crm_dev_password@127.0.0.1:5432/crm
# TLS: disable | require | verify (production default); see apps/api/.env.example
DATABASE_SSL=
DATABASE_SSL_CA=
LOG_LEVEL=info
# Bearer token for GET /metrics on WORKER_HEALTH_PORT. Empty = disabled. Production: >= 24 chars.
METRICS_TOKEN=

# BullMQ backend. Required in production. Empty in development = inline mode
# (jobs run in-process and are lost on restart). `pnpm dev:infra` starts Redis on 6379.
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=crm
WORKER_CONCURRENCY=5
JOB_KEEP_COMPLETED_HOURS=24
JOB_KEEP_FAILED_DAYS=7

# Outbox relay
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_DAYS=14

# Recurring jobs
REMINDER_INTERVAL_SECONDS=60
MAINTENANCE_INTERVAL_SECONDS=900

# Retention of OPERATIONAL records (maintenance sweep). CRM business records
# (leads, customers, tasks, messages, calls, notes, audit logs) are never deleted.
SESSION_RETENTION_DAYS=30
PASSWORD_RESET_RETENTION_DAYS=7
NOTIFICATION_RETENTION_DAYS=180
DELIVERY_RETENTION_DAYS=90
DELETED_FILE_RETENTION_DAYS=90

# Minimal /health/live and /health/ready for containers (0 = disabled)
WORKER_HEALTH_PORT=0
WORKER_SHUTDOWN_TIMEOUT_MS=25000

# Links in emails (password reset, invitations)
FRONTEND_URL=http://localhost:3000

# Email: smtp | memory (development only)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="CRM System" <noreply@crm.com>

# SMS: plivo | log (development only) | none (every SMS fails truthfully)
SMS_PROVIDER=none
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
# Public base of the Plivo webhooks; SMS delivery reports go to <this>/message-status
PLIVO_WEBHOOK_URL=
# Prefix for 10-digit national numbers (e.g. 91)
SMS_DEFAULT_COUNTRY_CODE=

# Storage (provider cleanup of deleted files): imagekit | memory (development only)
STORAGE_PROVIDER=imagekit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Outbound webhooks: 32-byte key (base64/hex) encrypting endpoint secrets at rest.
# Required in production and identical to the API's WEBHOOK_SECRET_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_SECRET_KEY=
# Development only (refused in production): allow http:// and private-network targets
WEBHOOK_ALLOW_PRIVATE_TARGETS=
WEBHOOK_TIMEOUT_MS=10000
