{
  "name": "@crm/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript conventions and runtime environment validation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tsconfig/*.json": "./tsconfig/*.json"
  },
  "files": [
    "dist",
    "tsconfig"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
