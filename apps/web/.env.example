# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
# never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
# The API must list this app origin in CORS_ORIGINS so the HttpOnly session cookies are sent.
# Use the same site as the API (e.g. app.example.com + api.example.com) or set AUTH_COOKIE_SAMESITE=none.
