{
  "name": "@crm/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker: transactional outbox relay, BullMQ consumers, reminders and maintenance",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "queue:check": "node dist/queue-check.js"
  },
  "dependencies": {
    "@crm/config": "workspace:*",
    "@crm/database": "workspace:*",
    "@crm/events": "workspace:*",
    "@crm/integrations": "workspace:*",
    "@crm/observability": "workspace:*",
    "bullmq": "^6.3.9",
    "dotenv": "^17.2.3",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
