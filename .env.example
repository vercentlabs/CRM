# ---------------------------------------------------------------------------
# CRM environment reference. Never commit real values.
#
# Each app reads its OWN file:
#   apps/api/.env      (copy apps/api/.env.example)
#   apps/web/.env.local (copy apps/web/.env.example)
#   apps/mobile/.env   (copy apps/mobile/.env.example)
#   apps/worker/.env   (copy apps/worker/.env.example)
# `pnpm db:migrate` reads DATABASE_URL from the environment, ./.env or apps/api/.env.
# This file only documents every variable in one place, grouped by app.
# ---------------------------------------------------------------------------

# === API (apps/api) — validated at startup by src/platform/env.ts ==========
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/crm_db   # required
JWT_SECRET=replace_with_a_long_random_string                                # required (>=32 chars in production)
ACCESS_TOKEN_TTL_SECONDS=900                                                 # access JWT lifetime
SESSION_TTL_DAYS=30                                                          # absolute session / refresh lifetime
REFRESH_REUSE_GRACE_SECONDS=10                                               # concurrent-tab refresh tolerance
CORS_ORIGINS=http://localhost:3000                                           # origins allowed to send auth cookies
AUTH_COOKIE_SECURE=                                                          # default: true in production
AUTH_COOKIE_SAMESITE=lax                                                     # lax | strict | none (none requires Secure)
AUTH_COOKIE_DOMAIN=
TRUST_PROXY=                                                                 # e.g. 1 behind one reverse proxy
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
FRONTEND_URL=http://localhost:3000                                          # password-reset links
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key                                # required (SDK built at import)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key                              # required
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id                        # required
PLIVO_AUTH_ID=your_plivo_auth_id                                            # required (SDK built at import)
PLIVO_AUTH_TOKEN=your_plivo_auth_token                                      # required
PLIVO_PHONE_NUMBER=
PLIVO_WEBHOOK_URL=                                                           # public URL of /api/plivo/webhook (signature verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="CRM System" <noreply@crm.com>
GOLD_API_KEY=your_alpha_vantage_key                                         # gold widget; unset = widget returns 503

# === Web (apps/web) — inlined at build time =================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# === Mobile (apps/mobile) — inlined by Expo ===================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# === Worker (apps/worker) =====================================================
WORKER_HEARTBEAT_SECONDS=60
REDIS_URL=                                                                   # unused until Phase 6

# === Database tooling / tests =================================================
# Disposable database for integration tests (a throwaway schema is created per run).
TEST_DATABASE_URL=
# pnpm org:bootstrap (creates an organization and its first admin)
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_SLUG=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
