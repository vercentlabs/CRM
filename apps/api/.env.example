# API environment. Validated at startup by src/platform/env.ts:
# missing required keys stop the process with a list of variable names.

# Server
NODE_ENV=development
PORT=5000
# Logs: JSON lines (pretty in development unless LOG_FORMAT=json). debug | info | warn | error
LOG_LEVEL=info
LOG_FORMAT=
# Requests slower than this are logged as http_request_slow
SLOW_REQUEST_MS=1000
# JSON body limit (uploads are limited separately to 10 MB)
BODY_LIMIT=1mb
# Bearer token for GET /metrics (Prometheus). Empty = endpoint disabled. Production: >= 24 chars.
METRICS_TOKEN=
# Graceful shutdown: readiness fails first, then in-flight requests finish
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=25000
# Build metadata (set by the Docker build; shown in /api/v1 and X-CRM-Version)
APP_VERSION=
GIT_SHA=
BUILD_TIME=

# Database (required). Also used by `pnpm db:migrate`.
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/crm_db
# TLS: disable | require (encrypted, no cert check) | verify (production default).
# Production refuses `disable` unless the host is private (localhost or a single-label service name).
DATABASE_SSL=
# PEM CA bundle when the provider uses a private CA (DATABASE_SSL=verify)
DATABASE_SSL_CA=
DATABASE_POOL_MAX=20

# Redis for shared rate limiting (required in production; rediss:// supported).
# Empty in development/tests = in-memory limiter (single process only).
REDIS_URL=
RATE_LIMIT_PREFIX=crm

# Auth (required). Use a long random value (>=32 chars) in production; it signs
# access tokens and derives CSRF tokens. Rotating it signs everyone out.
JWT_SECRET=replace_with_a_long_random_string
# Sessions (see docs/architecture/TENANCY_AND_AUTH.md)
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
# Browser origins allowed to send the auth cookies (comma separated). Defaults to FRONTEND_URL.
CORS_ORIGINS=http://localhost:3000
# Cookie flags: Secure defaults to true in production. SameSite=none requires Secure.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
# Set behind a reverse proxy (e.g. 1) so rate limiting and audit see the client IP
TRUST_PROXY=
# Login / refresh / password-reset attempts per IP+email per window, and per IP overall
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_IP_MAX=100
# Member management, uploads, messaging and webhook management: per user per minute
SENSITIVE_RATE_LIMIT_PER_MINUTE=60

# Gold API (Alpha Vantage). Without it the gold widget returns 503.
GOLD_API_KEY=your_gold_api_key

# Email (admin diagnostics only; password reset and invitation emails are sent by the worker)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="CRM System" <noreply@crm.com>

# Upload storage: imagekit | memory (development/tests only; refused in production)
STORAGE_PROVIDER=imagekit

# ImageKit (required at startup - placeholders are enough to boot, uploads need real keys)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
# Lifetime of signed file URLs (enable "Restrict unsigned URLs" in ImageKit for enforcement)
FILE_URL_TTL_SECONDS=600

# Outbound webhook management: 32-byte key (base64/hex) encrypting endpoint secrets.
# MUST be identical in the worker. Empty = webhook management answers 503.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_SECRET_KEY=
# Development only (refused in production): allow http:// and private-network targets
WEBHOOK_ALLOW_PRIVATE_TARGETS=

# Plivo (calls) - AUTH_ID/TOKEN required at startup; placeholders are enough to boot
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_PHONE_NUMBER=
# Public URL of /api/plivo/webhook (e.g. https://api.example.com/api/plivo/webhook).
# Required for webhook signature verification; webhooks are rejected without it.
# Check it and print the URLs to configure in Plivo: pnpm plivo:check [--probe]
PLIVO_WEBHOOK_URL=

# Frontend URL (password reset links)
FRONTEND_URL=http://localhost:3000

# First organization + admin (pnpm org:bootstrap). Never commit real values.
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_SLUG=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
