{
  "name": "@crm/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "org:bootstrap": "node dist/cli/bootstrap-organization.js",
    "org:bootstrap:dev": "tsx src/cli/bootstrap-organization.ts",
    "plivo:check": "node dist/cli/plivo-check.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "CRM REST API (Express modular monolith)",
  "dependencies": {
    "@crm/config": "workspace:*",
    "@crm/database": "workspace:*",
    "@crm/entitlements": "workspace:*",
    "@crm/events": "workspace:*",
    "@crm/integrations": "workspace:*",
    "@crm/observability": "workspace:*",
    "@crm/permissions": "workspace:*",
    "@crm/types": "workspace:*",
    "@crm/validation": "workspace:*",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "plivo": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
